# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...
SUPABASE_ANON_KEY=eyJ...anon_key...

# Rahasia untuk tanda tangan sesi admin & captcha (min. 32 karakter acak)
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# PIN admin saat pertama kali dijalankan (diubah lewat panel Admin)
ADMIN_INITIAL_PIN=ganti-dengan-pin-awal-anda
